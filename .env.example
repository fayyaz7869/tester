# Server Configuration
PORT=3000
NODE_ENV=production

# Cloudinary Configuration (Optional - for persistent cloud image storage)
# Agar aapke paas Cloudinary credentials nahi hai, toh app local disk (/uploads) me screenshots save karegi.
# Render pe deploy karte time Render Environment Variables me ye 3 daal de:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
